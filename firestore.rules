rules_version = '2';
// Reguły bezpieczeństwa Firestore dla Houser – wklej je w konsoli Firebase: Firestore Database → Reguły.
// projects/{id}            – opis projektu (nazwa, autor = owner, uprawnienia = visibility, miniaturka, statystyki)
// projects/{id}/content/*  – pełny projekt (JSON)
// projects/{id}/photos/*   – zdjęcia galerii
// visibility: 'private'     – widzi i zmienia tylko autor
//             'public'      – widzi każdy, zmienia tylko autor (inni robią duplikat do siebie)
//             'public_edit' – widzi każdy, zmieniać może każdy zalogowany; autor i uprawnienia zostają, usuwa tylko autor
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function mine(data) { return signedIn() && data.owner == request.auth.uid; }
    function isPublic(data) { return data.visibility in ['public', 'public_edit']; }
    function editable(data) { return signedIn() && data.visibility == 'public_edit'; }
    function canWrite(data) { return mine(data) || editable(data); }

    match /projects/{pid} {
      // resource == null: sprawdzenie, czy identyfikator jest wolny (nowy projekt)
      allow read: if resource == null || isPublic(resource.data) || mine(resource.data);
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.visibility in ['private', 'public', 'public_edit'];
      // autor zmienia wszystko; współautor (public_edit) – treść, ale nie autora ani uprawnień
      allow update: if request.resource.data.owner == resource.data.owner
        && request.resource.data.visibility in ['private', 'public', 'public_edit']
        && (mine(resource.data)
            || (editable(resource.data)
                && request.resource.data.visibility == resource.data.visibility
                && request.resource.data.ownerName == resource.data.ownerName));
      allow delete: if mine(resource.data);

      function parent() { return get(/databases/$(database)/documents/projects/$(pid)).data; }
      match /{sub}/{doc} {
        allow read: if sub in ['content', 'photos']
          && (isPublic(parent()) || (signedIn() && parent().owner == request.auth.uid));
        allow create, update: if sub in ['content', 'photos'] && canWrite(parent());
        // treść domu usuwa tylko autor (razem z domem); zdjęcie z galerii może usunąć też współautor
        allow delete: if (sub == 'content' && mine(parent())) || (sub == 'photos' && canWrite(parent()));
      }
    }
  }
}
